# edge-guard: the only listener in Open WebUI's network namespace.
#
# Open WebUI logs users in from X-Auth-Email / X-Auth-User (trusted-header
# SSO) but cannot tell who sent them, and it sits on inference-net, where any
# container could otherwise reach it with forged headers. So Open WebUI
# listens on 127.0.0.1:8081 only, and this nginx, sharing its network
# namespace, takes :8080. With OPEN_WEBUI_EDGE_SECRET set, it answers 403 to
# every request whose X-Edge-Secret is not that value (sent only by the edge
# gateway), so every request that reaches Open WebUI passed Authelia: a JWT
# alone is not enough, since Open WebUI checks the identity header only when
# one is present, and neither are the refresh tokens of its renewable sessions
# (v0.13.3, /api/v1/auths/sessions, 90 days). It passes the identity headers
# on only from verified requests and drops them otherwise. With the secret
# unset, both sides are empty and every request without the header passes
# with them, as before this guard existed.
#
# Rendered by the image's entrypoint: envsubst replaces only defined
# environment variables, so nginx's own $variables stay as they are.
# compose always defines OPEN_WEBUI_EDGE_SECRET (possibly empty) for that
# reason.

log_format scrubbed '$time_iso8601 "$request_method $uri $server_protocol" '
                    '$status $body_bytes_sent $request_time "$http_x_request_id"';

map $edge_verified $owui_auth_email  { 1 $http_x_auth_email;  default ""; }
map $edge_verified $owui_auth_user   { 1 $http_x_auth_user;   default ""; }
map $edge_verified $owui_auth_groups { 1 $http_x_auth_groups; default ""; }
map $edge_verified $owui_auth_name   { 1 $http_x_auth_name;   default ""; }

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

# Intake into Open WebUI's own stores is refused for everyone, admins
# included: file uploads and file content rewrites, knowledge bases and
# retrieval processing. Upstream enforces the upload permission only in its
# UI and lets admins past the knowledge permission, so compose's permission
# flags alone would not stop it. Reading and deleting what already exists
# still works, as do removing a file from a knowledge base and resetting one.
# $uri is the decoded, normalized path, so encoded or doubled slashes and dot
# segments cannot slip past; matching ignores case. The first matching
# expression wins, hence the exceptions first.
map "$request_method $uri" $owui_intake {
    default                                                      0;
    "~*^(POST|PUT|PATCH) /api/v1/knowledge/[^/]+/(file/remove|reset)$" 0;
    "~*^(POST|PUT|PATCH) /api/v1/files(/|$)"                     1;
    "~*^(POST|PUT|PATCH) /api/v1/knowledge(/|$)"                 1;
    "~*^(POST|PUT|PATCH) /api/v1/retrieval/process(/|$)"         1;
}

# Message ratings are refused for everyone, admins included. Rating an
# answer stores a full copy of the chat with the rating (its `snapshot`),
# and admins could read that copy through the single-rating and export
# routes whatever ENABLE_ADMIN_CHAT_ACCESS says. compose hides the rating
# controls, but upstream's routes check neither ENABLE_MESSAGE_RATING nor the
# rate_response permission. So creating or updating a rating, reading one
# rating and the export are refused; the lists, which carry no copy, and the
# deletes still pass, so existing ratings can be cleared. Matched like the
# intake above; HEAD is refused with GET, which upstream answers for it.
map "$request_method $uri" $owui_rating {
    default                                                        0;
    "~*^(POST|PUT|PATCH) /api/v1/evaluations/feedback(/|$)"        1;
    "~*^(GET|HEAD) /api/v1/evaluations/feedback/"                  1;
    "~*^(GET|HEAD) /api/v1/evaluations/feedbacks/all/export(/|$)"  1;
}

# Creating or changing tools and functions is refused for everyone, admins
# included. Both are Python that Open WebUI runs inside its backend, without a
# sandbox (utils/plugin.py). Open WebUI refuses to load that code while
# ENABLE_TOOLS and ENABLE_FUNCTIONS are false, but its routers check neither
# switch themselves; this is the second layer, which holds even if an image
# bump moves that check or the switches are dropped. So every write under those
# two routers is refused; reading and deleting still pass, so anything stored
# before can be cleared. Matched like the intake above.
map "$request_method $uri" $owui_code {
    default                                                  0;
    "~*^(POST|PUT|PATCH) /api/v1/(tools|functions)(/|$)"     1;
}

server {
    listen 8080;
    server_tokens off;
    access_log /var/log/nginx/access.log scrubbed;

    # Uploads and long chats pass straight through, as they did without
    # this guard.
    client_max_body_size 0;

    # Exact, case-sensitive string comparison.
    set $edge_verified 0;
    if ($http_x_edge_secret = "${OPEN_WEBUI_EDGE_SECRET}") {
        set $edge_verified 1;
    }

    # Only the gateway: an unverified request answers 403 with a JSON detail,
    # the shape of upstream's own errors, before anything else. 420 is only
    # the internal hand-off.
    error_page 420 = @gateway_only;
    if ($edge_verified = 0) {
        return 420;
    }
    location @gateway_only {
        default_type application/json;
        return 403 '{"detail":"Open WebUI is reachable only through the edge gateway."}';
    }

    # Refused intake (the map above) answers 403 with a JSON detail, the
    # shape of upstream's own errors. 418 is only the internal hand-off.
    error_page 418 = @intake_refused;
    if ($owui_intake) {
        return 418;
    }
    location @intake_refused {
        default_type application/json;
        return 403 '{"detail":"Uploads, knowledge bases and retrieval processing are disabled in this deployment."}';
    }

    # Refused ratings (the map above) the same way; 419 is their internal
    # hand-off.
    error_page 419 = @rating_refused;
    if ($owui_rating) {
        return 419;
    }
    location @rating_refused {
        default_type application/json;
        return 403 '{"detail":"Message ratings are disabled in this deployment."}';
    }

    # Refused tool and function writes (the map above) the same way; 421 is
    # their internal hand-off.
    error_page 421 = @code_refused;
    if ($owui_code) {
        return 421;
    }
    location @code_refused {
        default_type application/json;
        return 403 '{"detail":"Tools and functions cannot be created or changed in this deployment."}';
    }

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        # socket.io
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # An empty value makes nginx omit the header, so an unverified
        # request reaches Open WebUI without any identity header.
        proxy_set_header X-Auth-Email $owui_auth_email;
        proxy_set_header X-Auth-User $owui_auth_user;
        proxy_set_header X-Auth-Groups $owui_auth_groups;
        proxy_set_header X-Auth-Name $owui_auth_name;
        proxy_set_header X-Edge-Secret "";
        # Streaming responses (token streams, SSE) and uploads unbuffered.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }
}

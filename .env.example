# open-webui-service — example configuration
#
# deploy's `make env` writes .env from this file and keeps it in step
# (by hand: cp .env.example .env).
#
#   KEY=value     set per host
#   # KEY=value   optional; the value shown is the default
#
# Tags, on the line above a setting:
#   [required]          must be set on every host
#   [secret]            never printed; your value never follows the example
#   [shared: M [KEY]]   same value as member M (its KEY); make env fills it
#   [dev]               read only by the dev overlay (make up-dev)
#
# Open WebUI is reached through the edge gateway (https://<EDGE_HOST>:8443).
# The dev overlay (make up-dev) also publishes it on OPEN_WEBUI_HOST_PORT.

# =============================================================================
# Required
# =============================================================================

# The API key for the inference endpoint: the router's master key. Same value
# as OPENAI_API_KEY in vllm-service's .env (make env fills it). The compose
# fallback is a placeholder, so set the real key; there is no useful default.
# [required] [secret] [shared: vllm-service]
OPENAI_API_KEY=

# Hostname or IP of the edge gateway (edge-plane) fronting this app. It builds
# the Authelia logout redirect, so it must match edge-plane's EDGE_HOST (a
# dotted hostname or an IP). Compose falls back to `localhost` when unset.
# [required] [shared: edge-plane]
EDGE_HOST=

# =============================================================================
# Auth & identity
# =============================================================================

# Edge secret: edge-guard forwards the identity headers to Open WebUI only
# when the gateway's X-Edge-Secret matches this value. Same value as
# OPEN_WEBUI_EDGE_SECRET in edge-plane's .env; generate it there with
# `make secret`. Empty -> identity headers are trusted from any caller.
# [secret] [shared: edge-plane]
# OPEN_WEBUI_EDGE_SECRET=

# Signed user attribution at the router (vllm-service docs/audit.md): with a
# value, every call to the inference endpoint carries a short-lived token
# naming the user, and the router records that user as the call's actor.
# Same value as AUDIT_OPENWEBUI_JWT_SECRET in vllm-service's .env. Generate it
# once with `openssl rand -hex 32` and use it for nothing else (not
# WEBUI_SECRET_KEY, not the endpoint's API key). Empty -> no user information
# is forwarded, and the router names no Open WebUI user.
# [secret] [shared: vllm-service AUDIT_OPENWEBUI_JWT_SECRET]
# OPEN_WEBUI_FORWARD_JWT_SECRET=

# =============================================================================
# Network & proxy
# =============================================================================

# Names of the external networks to the inference stack and to the edge
# gateway. Created via `make network`. Override only if you renamed them.
# INFERENCE_NET=inference-net
# EDGE_NET=edge-net

# Proxy bypass: NO_PROXY/no_proxy are set in compose with sensible defaults
# (service aliases + private CIDR ranges). To append extra hostnames, set
# this (it must start with a leading comma), e.g. `,ollama,vllm-router`.
# EXTRA_NO_PROXY=

# =============================================================================
# Inference
# =============================================================================

# The OpenAI-compatible inference endpoint (chat and embeddings): the
# vllm-service router. Point it at another provider only by changing this.
# OPENAI_API_BASE_URL=http://vllm-router:4000/v1

# The chat model auto-selected for new chats. Empty -> Open WebUI picks the
# first model the endpoint lists.
# TEXT_MODEL=

# The embedding model id registered on the endpoint. The id differs per
# endpoint: vllm-service serves `BAAI/bge-m3`, Ollama `bge-m3:latest`.
# EMBED_MODEL=bge-m3:latest

# Speech-to-text endpoint (OpenAI /v1 base). Empty -> OPENAI_API_BASE_URL
# (production: vllm-router fronts the asr backend). Set a dedicated endpoint
# for dev, e.g. vllm-service's CPU asr-only stack:
#   WHISPER_API_BASE=http://asr-only:8000/v1
# WHISPER_API_BASE=

# API key for the speech-to-text endpoint. Empty -> OPENAI_API_KEY.
# [secret]
# WHISPER_API_KEY=

# The speech-to-text model id the endpoint serves.
# WHISPER_MODEL=openai/whisper-large-v3

# =============================================================================
# open-webui-service
# =============================================================================

# How long Open WebUI's own session token lives. Sign-out at the gateway
# cannot revoke it, so it is kept short; it renews silently while the gateway
# session lives.
# JWT_EXPIRES_IN=30m

# Where Open WebUI sends the browser after sign-out, to end the gateway
# session as well. The default is built from EDGE_HOST:
#   WEBUI_AUTH_SIGNOUT_REDIRECT_URL=https://<EDGE_HOST>/auth/logout
# WEBUI_AUTH_SIGNOUT_REDIRECT_URL=

# Only whether this is set matters to the stack: Open WebUI then keeps its
# chats in an external database, outside webui.db, and chat retention refuses
# to run. Leave it empty.
# DATABASE_URL=

# =============================================================================
# Audit & retention
# =============================================================================

# Retention (CLAUDE.md § Retention): the `retention` service deletes what Open
# WebUI keeps forever and records every deletion in the data-protection audit
# log. Speech-to-text recordings, their transcripts and text-to-speech output
# are deleted this many minutes after they were written; `off` keeps them.
# OPEN_WEBUI_AUDIO_RETENTION_MINUTES=60

# Chats are deleted, with everything that belongs only to them, this many days
# after they were started, however recently they changed; `off` keeps every
# chat, for development only. See what a period would delete:
#   make retention-dry-run CHAT_DAYS=180
# OPEN_WEBUI_CHAT_RETENTION_DAYS=365

# A new period deletes nothing for this many days after it took effect, so
# what is already older is announced first; a changed one never deletes sooner
# than announced (README: Retention).
# RETENTION_NOTICE_DAYS=30

# Seconds between two sweeps of the audio caches (chats: at start, then
# hourly).
# OPEN_WEBUI_RETENTION_INTERVAL_S=300

# =============================================================================
# Development only
# =============================================================================

# Host port of the dev overlay (make up-dev), which publishes Open WebUI.
# [dev]
# OPEN_WEBUI_HOST_PORT=3000
